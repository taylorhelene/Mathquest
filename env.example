# Copy to .env.local (local) or set these in Render → Environment.

# ——— Required ———
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=mathquest
JWT_SECRET=change-this-to-a-long-random-string
ADMIN_EMAILS=you@example.com

# ——— Email OTP (Resend) ———
# https://resend.com — free tier works; verify a domain for production
RESEND_API_KEY=
EMAIL_FROM=Math Quest <onboarding@resend.dev>

# ——— M-Pesa Daraja ———
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# Public HTTPS after deploy, e.g. https://math-quest.onrender.com/api/payments/callback
MPESA_CALLBACK_URL=https://YOUR-APP.onrender.com/api/payments/callback
PAID_LESSON_AMOUNT=100

# ——— ElevenLabs (optional; browser voice if missing/quota) ———
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ——— Gemma / OpenAI-compatible API (optional) ———
# Tutor hints + admin “Gemma briefing” on /admin
# Example: https://api.example.com/v1/chat/completions
GEMMA_API_URL=
GEMMA_API_KEY=
GEMMA_MODEL=gemma-2-9b-it
