# Copy to .env.local and fill in values. Never commit real secrets.

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=mathquest

# JWT for session cookies
JWT_SECRET=change-this-to-a-long-random-string

# ElevenLabs (optional — falls back to browser speech)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Gemma / OpenAI-compatible tutor endpoint (optional — has pedagogical fallback)
GEMMA_API_URL=
GEMMA_API_KEY=
GEMMA_MODEL=gemma-2-9b-it

# M-Pesa Daraja (sandbox first)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# Public HTTPS URL of /api/payments/callback (Render URL after deploy)
MPESA_CALLBACK_URL=https://YOUR-APP.onrender.com/api/payments/callback

# One-time unlock price in KES
PAID_LESSON_AMOUNT=100

# Comma-separated emails that can open /admin
ADMIN_EMAILS=you@example.com

# Set true for localhost / sandbox when Daraja callback cannot reach your server
ALLOW_MANUAL_PAYMENT_CONFIRM=true
